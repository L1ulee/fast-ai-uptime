{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@fau/db": ["../../packages/db/src"],
      "@fau/db/*": ["../../packages/db/src/*"],
      "@fau/core": ["../../packages/core/src"],
      "@fau/core/*": ["../../packages/core/src/*"],
      "@fau/providers": ["../../packages/providers/src"],
      "@fau/providers/*": ["../../packages/providers/src/*"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".turbo"]
}
