# ─── Database ────────────────────────────────────────────────────────
# 本地开发用 docker compose: 设置以下三项,docker-compose.yml 会自动组装 DATABASE_URL。
# 直连数据库 (eg. dev 不用 docker): 显式提供 DATABASE_URL 即可,以下三项不必设置。
POSTGRES_USER=fau
POSTGRES_PASSWORD=fau_change_me
POSTGRES_DB=fau
DATABASE_URL=postgres://fau:fau_change_me@localhost:5433/fau

# 反向代理跳数(默认 0 = 不信任 X-Forwarded-For)。
# 部署在 nginx/Caddy 等 1 层代理后:设 1。多层代理:设对应跳数。
TRUSTED_PROXY_HOPS=0
# 真正在 Cloudflare 后才设 1,否则攻击者可伪造 cf-connecting-ip 绕过限速。
TRUSTED_CLOUDFLARE=0
# 真正上游反代会注入 x-real-ip 才设 1。
TRUSTED_REAL_IP=0

# ─── Security ────────────────────────────────────────────────────────
# 32 字节 hex（用于加密 check_configs.api_key），生成命令：
#   openssl rand -hex 32
ENCRYPTION_KEY=

# 极简后台单密码（M0 用，生产环境必须改；启动时校验非默认值）
ADMIN_PASSWORD=changeme

# Session 签名密钥（HMAC-SHA256），生成命令：
#   openssl rand -hex 32
SESSION_SECRET=

# ─── Site ────────────────────────────────────────────────────────────
# docker compose 把容器内 3000 映射到宿主机 WEB_PORT;遇到 3000 被占用改成 3001 等即可。
# 直接 node 启动 (非 docker) 时本变量不生效,改 Next 的 PORT。
WEB_PORT=3000
# 对外访问地址,需与 WEB_PORT / 反代端口保持一致 (邮件 & Webhook 回链都用它)。
BASE_URL=http://localhost:3000

# ─── Probe ───────────────────────────────────────────────────────────
NODE_ID=local
POLL_INTERVAL_SECONDS=60
CHECK_CONCURRENCY=5
OFFICIAL_STATUS_INTERVAL_SECONDS=300
HISTORY_RETENTION_DAYS=30
