{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ENCRYPTION_KEY",
    "ADMIN_PASSWORD",
    "SESSION_SECRET",
    "BASE_URL",
    "NODE_ID",
    "POLL_INTERVAL_SECONDS",
    "CHECK_CONCURRENCY",
    "OFFICIAL_STATUS_INTERVAL_SECONDS",
    "HISTORY_RETENTION_DAYS",
    "PROBE_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
